APP_SECRET_KEY=change-me

# SQL Server connection
APP_SQL_HOST=localhost\\SQLEXPRESS
APP_SQL_PORT=1433
APP_SQL_DATABASE=NDMC
APP_SQL_USER=sa
APP_SQL_PASSWORD=change-me
APP_SQL_CLIENT=auto
APP_SQL_DRIVER=ODBC Driver 18 for SQL Server

# Auto-create database if it does not exist (then migrations create all tables)
APP_SQL_AUTO_CREATE_DB=1

# Web runtime
APP_HOST=0.0.0.0
APP_HTTP=1
APP_HTTPS=0
APP_DEBUG=1
